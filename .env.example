# Local Experiment Manager App environment (local runs only)
# Assumes you already authenticated with:
# databricks auth login --profile <your-profile>

# Databricks SDK profile to use for OAuth token lookup
DATABRICKS_CONFIG_PROFILE=<your-profile>

# Optional display label in app header
APP_ENV=dev

# Lakebase / Postgres connection settings
PGHOST=<your-lakebase-host>
PGPORT=5432
PGDATABASE=<your-lakebase-database>
PGUSER=oauth
PGSSLMODE=require

# Table/schema names used by the app
AB_TESTING_SCHEMA_NAME=ab_testing
EXPERIMENTS_TABLE_NAME=experiments
BENCHMARKS_TABLE_NAME=metric_benchmarks
